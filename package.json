{
  "name": "meowshell",
  "version": "2.3.0-beta.4",
  "private": true,
  "license": "GPL-3.0-only",
  "author": {
    "name": "kimi",
    "url": "https://github.com/kimi-1337"
  },
  "description": "A private, customizable desktop terminal with tabs, SSH, SFTP, themes, and screenshot paste.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimi-1337/meowshell.git"
  },
  "bugs": {
    "url": "https://github.com/kimi-1337/meowshell/issues"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "ensure:win-pty": "node scripts/ensure-win-pty.js",
    "dist": "npm run verify && npm run ensure:win-pty && electron-builder --win zip nsis --x64 --arm64",
    "dist:zip": "npm run verify && npm run ensure:win-pty && electron-builder --win zip --x64 --arm64",
    "dist:installer": "npm run verify && npm run ensure:win-pty && electron-builder --win nsis --x64 --arm64",
    "dist:ci:x64": "npm run ensure:win-pty && electron-builder --win zip --x64"
  },
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "com.kimi.meowshell",
    "productName": "MeowShell",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/cpu-features/**/*"
    ],
    "extraResources": [
      {
        "from": "fonts",
        "to": "fonts"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "README.ru.md",
        "to": "README.ru.md"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@lydell/node-pty/**/*",
      "node_modules/@lydell/node-pty-*/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "license": "LICENSE",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "41.10.5",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "5.5.0",
    "js-yaml": "4.3.2",
    "ssh2": "1.17.0"
  }
}
